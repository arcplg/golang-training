scalar ObjectID
scalar Date

type GroupQuestion {
  _id: ObjectID!
  title: String
  description: String
  thumbnailUrl: String
  questions: [Question]
  answers: [Answer]
  anyTime: Boolean
  startAt: Date
  endAt: Date
  publishedAt: Date
  createdAt: Date
  createdBy: User
  updatedAt: Date
  deletedAt: Date
}

type Answer {
  _id: ObjectID!
  user: User
  lock: Boolean
  questions: [Question]
  startAt: Date
  endAt: Date
  publishedAt: Date
  createdAt: Date
  updatedAt: Date
  deletedAt: Date
}

type Question {
  _id: ObjectID!
  originNumber: Int
  note: String
  text: String
  imageUrl: String
  videoUrl: String
  youtubeUrl: String
  questionItems: [QuestionItem]
  publishedAt: Date
  createdAt: Date
  createdBy: User
  updatedAt: Date
  deletedAt: Date
}

type QuestionItem {
  _id: ObjectID!
  key: String
  originNumber: Int
  text: String
  imageUrl: String
  videoUrl: String
  youtubeUrl: String
}

type QuestionTemplate {
  _id: ObjectID!
  originNumber: Int
  note: String
  text: String
  imageUrl: String
  videoUrl: String
  youtubeUrl: String
  questionTemplateItems: [QuestionTemplateItem]
  publishedAt: Date
  createdAt: Date
  updatedAt: Date
  deletedAt: Date
}

type QuestionTemplateItem {
  _id: ObjectID!
  key: String
  originNumber: Int
  text: String
  imageUrl: String
  videoUrl: String
  youtubeUrl: String
}

input QuestionItemInput {
  key: String
  originNumber: Int
  text: String
  imageUrl: String
  videoUrl: String
  youtubeUrl: String
}

input QuestionInput {
  originNumber: Int
  note: String
  text: String
  imageUrl: String
  videoUrl: String
  youtubeUrl: String
  questionItems: [QuestionItemInput]
}

input GroupQuestionInput {
  title: String
  description: String
  thumbnailUrl: String
  anyTime: Boolean
  startAt: Date
  endAt: Date
}

extend type Query {
  questions: [Question!]!
  groupQuestions: [GroupQuestion!]!
}

extend type Mutation {
  createQuestion(input: QuestionInput!): Question!
  createGroupQuestion(input: GroupQuestionInput!): GroupQuestion!
}