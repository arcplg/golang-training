type Todo {
  id: ID!
  text: String!
  done: Boolean!
  user: User!
}

type User {
  id: ID!
  name: String!
}

type Question {
  id: ID!
  title: String!
  description: String!
  user: User!
}

type Query {
  todos: [Todo!]!
  questions: [Question!]!
}

input NewTodo {
  text: String!
  userId: String!
}

input NewQuestion {
  title: String!
  description: String!
  userId: String!
}

type Mutation {
  createTodo(input: NewTodo!): Todo!
  createQuestion(input: NewQuestion!): Question!
}